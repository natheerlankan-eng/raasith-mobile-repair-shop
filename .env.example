# ---- DATABASE (use ONE of these) ----
# Hosted database like Neon: paste the full connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Or the older style:
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=

# ---- LOGIN SECURITY (all required in production) ----
# Long random text, at least 32 characters. Never share it. Changing it logs everyone out.
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_TEXT_AT_LEAST_32_CHARS"
# The first admin. Created automatically if this person does not exist yet.
ADMIN_EMAIL="owner@yourshop.com"
ADMIN_PASSWORD="CHANGE_ME_AT_LEAST_8_CHARS"
# Admin approval PINs for sensitive actions. Comma separated. If empty, no PIN works.
ADMIN_PINS="CHANGE_ME_PIN"
# Locked out? Set this to true for ONE restart to reset the admin password, then remove it.
# ADMIN_RESET_PASSWORD=true
